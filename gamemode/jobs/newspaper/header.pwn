new
	PlayerText:PlayerSubmissionText[MAX_PLAYERS][2],
	BikeStorage[MAX_PLAYERS],
	BikeLocation[MAX_PLAYERS],
	PlayerDeliveryCP[MAX_PLAYERS]
;

#include "jobs/newspaper/stocks.pwn"
#include "jobs/newspaper/timers.pwn"
#include "jobs/newspaper/callbacks.pwn"

NewspaperJob_TargetHit(playerid) {

	NewspaperJob_NewObjective(playerid);
	return true ;
}
NewspaperJob_TargetMiss(playerid) {

	NewspaperJob_NewObjective(playerid);
	return true ;
}

NewspaperJob_NewObjective(playerid) {
	DestroyDynamicRaceCP(PlayerDeliveryCP[playerid]);
	PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
	//cash it
	new where[128], new_location;
	again:
	new_location = random(sizeof(CourierShop));
	if(new_location == BikeLocation[playerid]) goto again;
	BikeLocation[playerid] = new_location;

	new address[ 64 ], zone [ 64 ] ;

	GetPlayerAddress(CourierShop[new_location][E_COURIER_STORE_POS_X], CourierShop[new_location][E_COURIER_STORE_POS_Y], address) ;
	GetCoords2DZone(CourierShop[new_location][E_COURIER_STORE_POS_X], CourierShop[new_location][E_COURIER_STORE_POS_Y], zone, sizeof ( zone ));

	format(where, sizeof(where), "Deliver the item to the ~r~checkpoint ~w~in ~b~%s, %s.", address, zone);

	new index = Property_GetClosestEntity( playerid, 15.0 ) ;

	new Float: x, Float: y, Float: z ;

	if(index != INVALID_PROPERTY_ID ) {

		x = Property [ index ] [ E_PROPERTY_EXT_X ] ; 
		y = Property [ index ] [ E_PROPERTY_EXT_Y ] ; 
		z = Property [ index ] [ E_PROPERTY_EXT_Z ] ;
	}

	else {
		x =CourierShop[new_location][E_COURIER_STORE_POS_X] ;
		y =CourierShop[new_location][E_COURIER_STORE_POS_Y] ; 
		z =CourierShop[new_location][E_COURIER_STORE_POS_Z] ;
	}

	GPS_MarkLocation(playerid, where, E_GPS_COLOR_DEFAULT, 
		CourierShop[new_location][E_COURIER_STORE_POS_X],
		CourierShop[new_location][E_COURIER_STORE_POS_Y],
		CourierShop[new_location][E_COURIER_STORE_POS_Z] 
	);

	PlayerDeliveryCP [ playerid ] = CreateDynamicRaceCP(4, 
		CourierShop[new_location][E_COURIER_STORE_POS_X],
		CourierShop[new_location][E_COURIER_STORE_POS_Y],
		CourierShop[new_location][E_COURIER_STORE_POS_Z], 

		x, y, z, 5.0, -1, -1,-1
	);

	return true ;
}

NewspaperJob_UpdateTextdraw(playerid) {

	new str[10] ;
	format(str, sizeof(str), "%d", BikeStorage[playerid]);
	PlayerTextDrawSetString(playerid, PlayerSubmissionText[playerid][1], str);
	return true ;
}