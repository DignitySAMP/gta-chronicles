static AddModels()
{
    // Models for map requested by AmR
    AddSimpleModel(-1, CUSTOM_OBJECT_BASEID, REQ_AMR_JEWELPOSTER, "reqs/AmR/jewelryposter.dff", "reqs/AmR/jewelryposter.txd");
}

static const MAP_WORLD = 2241;
static const MAP_INT = 126;

static CreateJewelObject(modelid, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, world, int, playerid, Float:sd, Float:dd, area = -1, priority = 0)
{
    #pragma unused world, int, playerid

    if (modelid == 2710 || modelid == 11750 || modelid == 2961 || modelid == 19186 || modelid == 2707)
    {
        priority = -1; 
        dd = 15.0; 
        sd = 15.0;
    }
    else if (modelid == 19370 || modelid == 19433 || modelid == 8533 || modelid == 19376 || modelid == 19446 || modelid == 19937 || modelid == REQ_AMR_JEWELPOSTER)
    {
        priority = 1;
        dd = 300.0;
        sd = 300.0;
    }
    else
    {
        priority = 0;
        dd = 50.0;
        sd = 50.0;
    } 

    return CreateDynamicObject(modelid, x, y, z, rx, ry, rz, MAP_WORLD, MAP_INT, -1, sd, dd, area, priority);
}

