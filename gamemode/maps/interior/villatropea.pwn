static AddModels()
{
    // Models for map requested by Slipky / CCF
    AddSimpleModel(-1, CUSTOM_OBJECT_BASEID, REQ_SLIPKY_MONITOR, "reqs/slipky/monitor.dff", "reqs/slipky/monitor.txd");
    AddSimpleModel(-1, CUSTOM_OBJECT_BASEID, REQ_SLIPKY_DESKTOP, "reqs/slipky/desktop.dff", "reqs/slipky/desktop.txd");
    AddSimpleModel(-1, CUSTOM_OBJECT_BASEID, REQ_SLIPKY_BARSTOOL, "reqs/slipky/barstool.dff", "reqs/slipky/barstool.txd");
    AddSimpleModel(-1, CUSTOM_OBJECT_BASEID, REQ_SLIPKY_TOILET1, "reqs/slipky/toiletpaperholder.dff", "reqs/slipky/toiletpaperholder.txd");
    AddSimpleModel(-1, CUSTOM_OBJECT_BASEID, REQ_SLIPKY_TOILET2, "reqs/slipky/toiletbrush.dff", "reqs/slipky/toiletbrush.txd");
    AddSimpleModel(-1, 19475, REQ_SLIPKY_DIVIDER, "reqs/slipky/woodendivider.dff", "reqs/slipky/woodendivider.txd");
    AddSimpleModel(-1, CUSTOM_OBJECT_BASEID, REQ_SLIPKY_TROLLEY, "reqs/slipky/traytrolley.dff", "reqs/slipky/traytrolley.txd");
    AddSimpleModel(-1, CUSTOM_OBJECT_BASEID, REQ_SLIPKY_CHANDEL, "reqs/slipky/MenaceChandelier_samp.dff", "reqs/slipky/svbits.txd");
}

