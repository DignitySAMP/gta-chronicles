#include <YSI_Coding\y_hooks>

static tmpobjid;

CMD:gotosanint(playerid)
{
    if (GetPlayerAdminLevel(playerid) < ADMIN_LVL_JUNIOR) return 0;

    SetPlayerPos(playerid,  746.14429, -1364.03201, 9053.99512);
    SetPlayerInterior(playerid, 1);
    return 1;
}

CMD:gotosanstudio(playerid)
{
    if (GetPlayerAdminLevel(playerid) < ADMIN_LVL_JUNIOR) return 0;

    SetPlayerPos(playerid,  2287.45093, 1476.74646, 9001.53809);
    SetPlayerInterior(playerid, 1);
    return 1;
}

